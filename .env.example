# Copy to .env and adjust. .env is gitignored.

# Postgres container settings (used by docker-compose)
POSTGRES_USER=fightnight
POSTGRES_PASSWORD=fightnight
POSTGRES_DB=fightnight

# Used when running the backend on your machine (outside Docker).
# Port 5433 is the host port docker-compose exposes for the db container.
DATABASE_URL=postgresql+psycopg://fightnight:fightnight@localhost:5433/fightnight

# Scraper: Wikipedia requires bots to include contact info (email or URL) in the User-Agent.
SCRAPER_CONTACT=you@example.com
